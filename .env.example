# Backend settings.
NODE_ENV=production
PORT=3002
# Normal startup is read-only readiness; maintenance needs a separate local CLI command.
# Leave these blank. They are not Vercel settings and do not authorize production.
DATABASE_MAINTENANCE_TARGET_SHA256=
DATABASE_MIGRATION_APPROVAL=
DATABASE_SEED_APPROVAL=

# Used only when creating the first production administrator.
ADMIN_USERNAME=admin_kt
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
# Resend email recovery. Verify the sender domain in Resend before configuring this.
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=District Line <security@example.com>
# Public application origin used to create reset links (server-side only).
APP_URL=https://your-production-domain.example
# Enable only after migration 005 is explicitly approved and applied to that database.
ENABLE_ADMIN_USERNAME_RECOVERY=false
# Build-time frontend flag; rebuild the frontend after changing it.
VITE_ENABLE_ADMIN_USERNAME_RECOVERY=false
# Keep both off until migration 006 is separately approved and applied.
ENABLE_ADMIN_RECOVERY_EMAIL_VERIFICATION=false
VITE_ENABLE_ADMIN_RECOVERY_EMAIL_VERIFICATION=false

# Comma-separated frontend origins. Leave empty for same-origin hosting.
CORS_ORIGIN=
# Defaults to Lax for same-site Vercel hosting. Use None only for a cross-site
# frontend/API deployment with HTTPS and an explicit CORS_ORIGIN allowlist.
SESSION_COOKIE_SAME_SITE=lax

# Supabase PostgreSQL connection string (keep this secret; backend only).
DATABASE_URL=
# Use disable only for local PostgreSQL without TLS. Supabase should use TLS.
DATABASE_SSL=require
# Localhost-only development may use disable; production always verifies TLS.
# Enable only after separately approved manual migration 008 and isolated tests.
ENABLE_LOGIN_RATE_LIMIT=false
LOGIN_RATE_LIMIT_KEY=
# off -> enroll -> enforce; enforcement requires separate owner approval.
# Migration 009 and recovery verification are required before enrollment.
ADMIN_MFA_MODE=off
ADMIN_MFA_ENCRYPTION_KEY=
VITE_ENABLE_ADMIN_MFA_ENROLLMENT=false

# Supabase Storage bucket for bus and staff images. Keep the service role key private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=district-line-uploads

# SmsLenz booking and read-only balance API. Keep real credentials in .env only.
SMS_PROVIDER=smslenz
SMS_USER_ID=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_HOTLINE=0779040300

# For a separately hosted frontend, set these at build time.
# VITE_API_BASE=https://api.example.com/api
# VITE_ASSET_BASE_URL=https://api.example.com
