# Documentation template only. Do not copy into the production project or root .env.
# Every secret is blank. Populate only in the separately approved staging Vercel project.

# Staging Supabase project only. Required for API startup; must never be production.
DATABASE_URL=
DATABASE_SSL=require

# Vercel deployed runtime. Vercel supplies VERCEL and VERCEL_ENV itself.
NODE_ENV=production
CORS_ORIGIN=https://<approved-staging-host>
SESSION_COOKIE_SAME_SITE=lax

# Optional stage-only image bucket. Leave all three blank if upload testing is not needed.
# If enabled, use a new staging Supabase project URL, a stage-only service-role key,
# and a bucket such as district-line-staging-uploads. Never use production values.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Messaging deliberately disabled. Do not set credentials for staging tests.
SMS_PROVIDER=disabled
SMS_USER_ID=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_HOTLINE=

# Recovery email deliberately disabled. Do not set provider credentials.
RESEND_API_KEY=
RECOVERY_EMAIL_FROM=
APP_URL=https://<approved-staging-host>
ENABLE_ADMIN_USERNAME_RECOVERY=false
VITE_ENABLE_ADMIN_USERNAME_RECOVERY=false
ENABLE_ADMIN_RECOVERY_EMAIL_VERIFICATION=false
VITE_ENABLE_ADMIN_RECOVERY_EMAIL_VERIFICATION=false

# Keep optional security features off until their separate migrations and test plan
# are approved. Do not apply migrations 008 or 009 as part of initial setup.
ENABLE_LOGIN_RATE_LIMIT=false
LOGIN_RATE_LIMIT_KEY=
ADMIN_MFA_MODE=off
ADMIN_MFA_ENCRYPTION_KEY=
VITE_ENABLE_ADMIN_MFA_ENROLLMENT=false

# Build-time front-end routing. Blank means same-origin Vercel staging deployment.
VITE_API_BASE=
VITE_ASSET_BASE_URL=

# Intentionally omitted: ADMIN_PASSWORD, DATABASE_MAINTENANCE_TARGET_SHA256,
# DATABASE_MIGRATION_APPROVAL, DATABASE_SEED_APPROVAL. Use a separate approved
# one-time local migration process; never place its target URL here.
