  "functions": [
    {
      "oid": 18044,
      "name": "prevent_duplicate_duty_trip()",
      "definition": "CREATE OR REPLACE FUNCTION public.prevent_duplicate_duty_trip()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN\n  IF EXISTS (\n    SELECT 1\n    FROM bus_duties d\n    WHERE d.id IS DISTINCT FROM NEW.id\n      AND (\n        d.first_trip_id IN (NEW.first_trip_id, NEW.return_trip_id)\n        OR d.return_trip_id IN (NEW.first_trip_id, NEW.return_trip_id)\n      )\n  ) THEN\n    RAISE EXCEPTION 'A trip is already assigned to a bus duty';\n  END IF;\n  RETURN NEW;\nEND;\n$function$\n",
      "proacl": "{=X/postgres,postgres=X/postgres,anon=X/postgres,authenticated=X/postgres,service_role=X/postgres}"
    }
