{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "server/migrations/**/*.sql"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?path=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
