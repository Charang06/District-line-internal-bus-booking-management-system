{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.js": {
      "includeFiles": "server/migrations/**/*.sql"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/[...route]?route=:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
